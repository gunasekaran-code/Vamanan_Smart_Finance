<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks cleartext HTTP by default since API 28. The API base URL
  defaults to a plain-HTTP localhost during development (10.0.2.2 is how the
  emulator reaches the host machine), so cleartext is permitted for those
  hosts only — every other destination, including the production API, still
  has to be HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
